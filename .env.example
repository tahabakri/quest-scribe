# Copy to .env for local runs. On a host, set these in its dashboard instead.

# debug | info | warn | error
LOG_LEVEL=info

# Where the write-ahead log lives. Must be persistent storage in production.
DATA_DIR=data

# Telegram: @BotFather > /newbot gives the token. It is a password: never commit it.
TELEGRAM_BOT_TOKEN=
# The private channel that receives a copy of every submission. Add the bot to it as an
# administrator with permission to post. Its ID starts with -100.
TG_REVIEW_CHANNEL_ID=
# The community group where members post their submissions in the group itself (starts with -100).
# Several: separate with commas. Leave empty for private chats only. @BotFather > /setprivacy > Disable.
TG_GROUP_IDS=
# Only for a self-hosted Bot API server: where it lives, e.g. http://localhost:8081
# TELEGRAM_API_ROOT=

# When submissions close. UTC, written out: 2026-11-22T23:59:59Z
# CAMPAIGN_END_UTC=

# Google Sheets. The ID is the part of the sheet URL between /d/ and /edit (the
# full URL works too). Share the sheet with the service account's email as Editor.
GOOGLE_SHEET_ID=
# Either a path to the downloaded key file, or the key JSON itself on ONE line
# (unquoted). A path is easiest locally; hosts usually want the JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# Config file location (default ./config.yml). Alternatively put the whole YAML
# document in CONFIG_YAML, which wins over the file.
# CONFIG_PATH=config.yml
# CONFIG_YAML=
